      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8086"
    },
    {
      "key": "reservationId",
      "value": ""
    },
    {
      "key": "balanceId",
      "value": ""
    },
    {
      "key": "ledgerEntryId",
      "value": ""
