          "name": "Resource Topics (broker)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/topics",
            "description": "Resource subscribes to player.registered and game.action_completed (its Discovery registration lists them) and produces resource.gathered: see their queue depth, deliveries and dead letters."
