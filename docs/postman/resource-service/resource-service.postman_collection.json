    {
      "name": "Operations",
      "item": [
        {
          "name": "Internal Route Called by a Client (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              },
              {
                "key": "X-Caller",
                "value": "client"
              },
              {
                "key": "X-Player-Id",
                "value": "42"
              }
            ],
            "url": "{{brokerUrl}}/call/resource/resources/balances",
            "description": "The broker sends its own key on every call, so the gateway marks a player's request with X-Caller: client. The service then treats it as the player's: internal-only routes answer 403 FORBIDDEN."
          }
        },
        {
          "name": "Internal Route Not Served by the Gateway (404)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/resources/balances",
            "description": "Only client routes are reachable from outside: the gateway does not serve service-to-service endpoints."
          }
        },
        {
          "name": "Metrics of One Instance (Prometheus)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/resource/metrics",
            "description": "What Prometheus scrapes from every Resource replica on :8086/metrics: http_requests_total, http_request_duration_seconds, active_tasks, max_concurrent_tasks, upstream_calls_total, events_consumed_total, events_published_total and the Node.js process metrics."
          }
        },
        {
          "name": "Recent Logs of One Instance (internal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/resource/internal/logs?level=info&limit=100",
            "description": "NDJSON, oldest first, from the instance the broker picked (X-Upstream-Instance); X-Log-Oldest and X-Log-Buffered describe its buffer."
          }
        },
        {
          "name": "Resource Logs (gateway, every instance)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{baseUrl}}/logs?service=resource&since=15m&level=info",
            "description": "The gateway asks every Resource instance Discovery lists for GET /internal/logs and merges the lines by time; X-Logs-Sources names the instances that answered."
          }
        }
      ]
    },
