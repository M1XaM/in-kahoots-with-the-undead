            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/topics/game.action_completed/events",
            "description": "Room 3 (Lab 204) / node 1 is metal, as in World Service's seed. Resource asks World for the room through the broker (Broker.Call), credits metal and publishes resource.gathered.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"type\": \"game.action_completed\",\n  \"version\": 1,\n  \"occurredAt\": \"2026-09-25T10:00:00Z\",\n  \"payload\": {\n    \"actionId\": \"{{$guid}}\",\n    \"sessionId\": \"7a90\",\n    \"playerId\": 42,\n    \"type\": \"scavenge\",\n    \"roomId\": 3,\n    \"nodeId\": 1,\n    \"completedAt\": \"2026-09-25T10:00:00Z\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
