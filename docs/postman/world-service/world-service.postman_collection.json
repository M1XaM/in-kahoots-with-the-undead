{
  "info": {
    "name": "World Service",
    "description": "World Service, Lab 4: players go through the API Gateway (http://localhost:8080), which hands every request to the message broker; service-to-service requests (Game, Base, Resource and admin) go straight to the broker (http://localhost:8091, /call/world/...). Run 'Auth (run first)' to register and log in a player. World receives exam.completed from the broker topic (it registers the topic with Discovery) and publishes world.wing_unlocked to its topic; pass an exam through the Exam collection, or publish exam.completed in Events, and the matching wing shows unlocked: true. Operations shows logs, metrics and the 403 for internal routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "brokerUrl",
      "value": "http://localhost:8091"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "playerId",
      "value": ""
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "roomId",
      "value": ""
    },
    {
      "key": "wingId",
      "value": ""
    },
    {
      "key": "wingName",
      "value": ""
    },
    {
      "key": "pointId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth (run first)",
      "item": [
        {
          "name": "Register Player",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"demo{{$timestamp}}\",\n  \"password\": \"hunter2hunter2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('username', pm.response.json().username);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"hunter2hunter2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const match = cookie.match(/access_token=([^;]+)/);",
                  "if (match) pm.collectionVariables.set('accessToken', match[1]);",
                  "pm.collectionVariables.set('playerId', pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Gateway Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Get All Rooms (player via gateway)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/world/rooms?unlocked=true"
          }
        },
        {
          "name": "Get Room (player via gateway)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/world/rooms/3"
          }
        },
        {
          "name": "Get Rooms by Wing (internal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/rooms?wingId=1",
            "description": "What Game and Base ask, through the broker with X-Internal-Key."
          }
        },
        {
          "name": "Get All Rooms (invalid token, 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-valid-token"
              }
            ],
            "url": "{{baseUrl}}/world/rooms",
            "description": "The gateway validates the Authorization header itself and answers 401 UNAUTHENTICATED; World is never reached and never sees the header."
          }
        }
      ]
    },
    {
      "name": "Rooms (admin)",
      "item": [
        {
          "name": "Create Room",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/rooms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chem Lab\",\n  \"type\": \"laboratory\",\n  \"wingId\": 2,\n  \"resourceNode\": { \"resourceType\": \"metal\" }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Service to service: through the broker with X-Internal-Key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('roomId', pm.response.json().roomId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Room",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/rooms/{{roomId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chem Lab 2\",\n  \"type\": \"laboratory\",\n  \"wingId\": 2,\n  \"resourceNode\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Service to service: through the broker with X-Internal-Key."
          }
        },
        {
          "name": "Delete Room",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/rooms/{{roomId}}",
            "description": "Service to service: through the broker with X-Internal-Key."
          }
        }
      ]
    },
    {
      "name": "Wings",
      "item": [
        {
          "name": "Get All Wings (player via gateway)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/world/wings"
          }
        },
        {
          "name": "Get Wing (player via gateway)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/world/wings/4"
          }
        }
      ]
    },
    {
      "name": "Wings (admin)",
      "item": [
        {
          "name": "Create Wing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/wings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chemistry Wing {{$timestamp}}\",\n  \"unlocked\": false,\n  \"unlockedBySubject\": \"chemistry\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Service to service: through the broker with X-Internal-Key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const wing = pm.response.json();",
                  "pm.collectionVariables.set('wingId', wing.wingId);",
                  "pm.collectionVariables.set('wingName', wing.name);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Wing",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/wings/{{wingId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{wingName}}\",\n  \"unlocked\": true,\n  \"unlockedBySubject\": \"chemistry\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Locked to unlocked publishes world.wing_unlocked, as a passed exam would."
          }
        },
        {
          "name": "Delete Wing",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/wings/{{wingId}}",
            "description": "Service to service: through the broker with X-Internal-Key."
          }
        }
      ]
    },
    {
      "name": "Spawn Points (internal)",
      "item": [
        {
          "name": "Get Spawn Points",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/spawn-points?roomId=3",
            "description": "Service to service: through the broker with X-Internal-Key."
          }
        },
        {
          "name": "Get Spawn Point",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/spawn-points/2",
            "description": "Service to service: through the broker with X-Internal-Key."
          }
        },
        {
          "name": "Create Spawn Point",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/spawn-points",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 3,\n  \"zombieTypes\": [\"dean\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Service to service: through the broker with X-Internal-Key."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('pointId', pm.response.json().pointId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Spawn Point",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/spawn-points/{{pointId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomId\": 3,\n  \"zombieTypes\": [\"dean\", \"janitor\"]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Service to service: through the broker with X-Internal-Key."
          }
        },
        {
          "name": "Delete Spawn Point",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/spawn-points/{{pointId}}",
            "description": "Service to service: through the broker with X-Internal-Key."
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Exam Completed (publish to the broker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/topics/exam.completed/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"type\": \"exam.completed\",\n  \"version\": 1,\n  \"occurredAt\": \"2026-11-12T12:00:00Z\",\n  \"payload\": { \"examId\": 17, \"playerId\": 1, \"subject\": \"math\", \"passed\": true, \"grade\": 8 }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Publishes exam.completed to the broker, which delivers it to every subscriber (World, Game, Crafting), to World over gRPC (Endpoint.Deliver) since it registered a grpc_url. A pass in math unlocks the Math Wing and World publishes world.wing_unlocked; a repeated eventId is ignored by the broker."
          }
        },
        {
          "name": "Deliver to World Directly (processed, then duplicate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/internal/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"6f1c0c3e-0000-4000-8000-000000000001\",\n  \"type\": \"exam.completed\",\n  \"version\": 1,\n  \"occurredAt\": \"2026-11-12T12:00:00Z\",\n  \"payload\": { \"examId\": 18, \"playerId\": 1, \"subject\": \"physics\", \"passed\": false, \"grade\": 3 }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "What the broker does for each event: POST /internal/events on one World replica. Send it twice: the first answers outcome processed, the second duplicate (processed_events, whichever replica gets it)."
          }
        },
        {
          "name": "Malformed Exam Completed (dead-lettered)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/topics/exam.completed/events",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{$guid}}\",\n  \"type\": \"exam.completed\",\n  \"version\": 1,\n  \"occurredAt\": \"2026-11-12T12:00:00Z\",\n  \"payload\": { \"examId\": 19, \"playerId\": 1, \"subject\": \"math\", \"passed\": \"yes\", \"grade\": 9 }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "passed is not a boolean: World answers 400 (INVALID_ARGUMENT over gRPC) and the broker moves the event to the dead letter channel at once instead of retrying."
          }
        },
        {
          "name": "World Topics (broker)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/topics",
            "description": "World subscribes to exam.completed (its Discovery registration lists it) and produces world.wing_unlocked (Game and Crafting subscribe): queue depth, deliveries and dead letters."
          }
        },
        {
          "name": "World Dead Letters (broker)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/dead-letters?subscriber=world",
            "description": "Events World refused (the malformed one above, reason rejected) or that failed 5 delivery attempts."
          }
        }
      ]
    },
    {
      "name": "Operations",
      "item": [
        {
          "name": "Internal Route Called by a Client (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              },
              {
                "key": "X-Caller",
                "value": "client"
              },
              {
                "key": "X-Player-Id",
                "value": "{{playerId}}"
              }
            ],
            "url": "{{brokerUrl}}/call/world/world/spawn-points",
            "description": "The broker sends its own key on every call, so the gateway marks a player's request with X-Caller: client. World then treats it as the player's: internal-only routes answer 403 FORBIDDEN."
          }
        },
        {
          "name": "Internal Route Through the Gateway (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/world/spawn-points",
            "description": "A logged-in player cannot use an internal route: the gateway forwards it through the broker marked X-Caller: client and World answers 403 FORBIDDEN (routes under /internal/ are not served by the gateway at all)."
          }
        },
        {
          "name": "Metrics of One Instance (Prometheus)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/metrics",
            "description": "What Prometheus scrapes from every World replica: http_requests_total, http_request_duration_seconds, active_tasks, max_concurrent_tasks, upstream_calls_total, events_published_total, events_consumed_total and the Node.js process metrics."
          }
        },
        {
          "name": "Recent Logs of One Instance (internal)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{brokerUrl}}/call/world/internal/logs?level=info&limit=100",
            "description": "NDJSON, oldest first, from the instance the broker picked (X-Upstream-Instance); X-Log-Oldest and X-Log-Buffered describe its buffer."
          }
        },
        {
          "name": "World Logs (gateway, every instance)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "changeme"
              }
            ],
            "url": "{{baseUrl}}/logs?service=world&since=15m&level=info",
            "description": "The gateway asks every World instance Discovery lists for GET /internal/logs and merges the lines by time; X-Logs-Sources names the instances that answered."
          }
        }
      ]
    }
  ]
}
