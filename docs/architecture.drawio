        <mxCell id="b_crafting" value="Service Boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="620" width="300" height="240" as="geometry" /></mxCell>
        <mxCell id="crafting" value="Crafting Service&#10;&#10;recipes, atomic crafting,&#10;unlock conditions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="660" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="db_crafting0" value="PostgreSQL ×3&#10;(Patroni)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="1230" y="780" width="120" height="60" as="geometry" /></mxCell>
        <mxCell id="db_e_crafting0" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="crafting" target="db_crafting0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="broker" value="&lt;b&gt;Camus Message Broker&lt;/b&gt; · Dart · :8091 HTTP · :8092 gRPC · every service-to-service call and every event goes through it (X-Internal-Key) · registers with Discovery like a service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1380" height="130" as="geometry" /></mxCell>
        <mxCell id="brk_queues" value="&lt;b&gt;Request queues&lt;/b&gt; (subscriber-based)&lt;br&gt;one bounded FIFO per target service&lt;br&gt;dispatch when an instance has capacity&lt;br&gt;429 queue full · 503 no instance · 504 deadline" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="brk_lb" value="&lt;b&gt;Load balancer + circuit breakers&lt;/b&gt;&lt;br&gt;round-robin → least-load&lt;br&gt;3 failures in 105 s trip an instance&lt;br&gt;reroute only idempotent calls · reports to Discovery" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="brk_topics" value="&lt;b&gt;Topics&lt;/b&gt; (topic-based)&lt;br&gt;durable queue per (topic, subscriber service)&lt;br&gt;subscribers come from Discovery &lt;i&gt;topics&lt;/i&gt;&lt;br&gt;retry 1 s → 30 s, 5 attempts, then dead letter" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="brk_dlq" value="&lt;b&gt;Dead letter channel + store&lt;/b&gt;&lt;br&gt;max_attempts · rejected · no_subscribers&lt;br&gt;GET /dead-letters · GET /topics&lt;br&gt;LogStore: append-only log, fsync before 202" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="client" value="Game client (browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="80" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="b_gateway" value="Service Boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="150" width="340" height="230" as="geometry" /></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt; · Python / FastAPI · :8080&lt;br&gt;single entry point for the client&lt;br&gt;JWT authorization (Authorization header never forwarded)&lt;br&gt;auth cache: verified tokens + logout revocations&lt;br&gt;saga coordinator: POST /sagas/{name}&lt;br&gt;task timeout + concurrent task limit&lt;br&gt;routes by path prefix to the broker: /call/{service}/…&lt;br&gt;GET /logs: merged NDJSON log download&lt;br&gt;WebSocket negotiation: GET /ws/game" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#111827;strokeWidth=2;fontColor=#ffffff;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="185" width="300" height="170" as="geometry" /></mxCell>
        <mxCell id="b_discovery" value="Service Boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="430" width="340" height="240" as="geometry" /></mxCell>
        <mxCell id="discovery" value="Discovery Service · :8089&#10;&#10;instance registry, heartbeat TTL,&#10;health checks (/status), load alerts&#10;+ topics, grpc_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="470" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="db_discovery" value="Registry&#10;(in-memory)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="1765" y="590" width="90" height="60" as="geometry" /></mxCell>
        <mxCell id="db_e_discovery" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="discovery" target="db_discovery"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="telegram" value="Telegram bot (alert channel)&#10;optional: TELEGRAM_BOT_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="730" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="discovery_note" value="&lt;b&gt;Every service (gateway and broker included)&lt;/b&gt; → Discovery:&lt;br&gt;POST /services/register on startup (with topics, grpc_url)&lt;br&gt;PUT …/heartbeat every 10 s (404 = register again)&lt;br&gt;DELETE …/instances/{id} on shutdown&lt;br&gt;&lt;b&gt;Discovery&lt;/b&gt; → every instance: GET /status every 5 s&lt;br&gt;3 failed checks = unhealthy · no sign of life for 30 s = dropped&lt;br&gt;load = active / max tasks: ≥ 0.7 warn, ≥ 0.9 alert&lt;br&gt;&lt;b&gt;Broker&lt;/b&gt; → Discovery: GET /services every 2 s, failure reports" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#f0fdfa;strokeColor=#0f766e;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="800" width="340" height="140" as="geometry" /></mxCell>
        <mxCell id="monitoring" value="&lt;b&gt;Monitoring&lt;/b&gt; · Prometheus :9090 · Grafana :3001&lt;br&gt;scrapes /metrics on the gateway, Discovery, the broker and every service replica&lt;br&gt;Grafana dashboard &quot;Kahoot With Undead&quot; (provisioned)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#f9fafb;strokeColor=#6b7280;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="955" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="e_client_gateway" value="REST · cookie or Bearer" style="html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1810" y="120" as="sourcePoint" /><mxPoint x="1810" y="185" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_client_game_ws" value="Socket.IO /game (URL negotiated at the gateway, then direct)" style="html=1;endArrow=block;strokeColor=#6c8ebf;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="100" as="sourcePoint" /><mxPoint x="580" y="150" as="targetPoint" /><Array as="points"><mxPoint x="580" y="100" /></Array></mxGeometry></mxCell>
        <mxCell id="e_gw_broker" value="POST/GET /call/{service}/…&#10;X-Timeout-Ms · X-Internal-Key&#10;gRPC (or HTTP)" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="250" as="sourcePoint" /><mxPoint x="1440" y="470" as="targetPoint" /><Array as="points"><mxPoint x="1540" y="250" /><mxPoint x="1540" y="470" /></Array></mxGeometry></mxCell>
        <mxCell id="e_broker_discovery" value="GET /services (poll 2 s)&#10;POST …/failures&#10;register + heartbeat" style="html=1;startArrow=block;endArrow=block;strokeColor=#0f766e;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="520" as="sourcePoint" /><mxPoint x="1640" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_gw_discovery" value="register + heartbeat" style="html=1;startArrow=block;endArrow=block;strokeColor=#0f766e;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1810" y="380" as="sourcePoint" /><mxPoint x="1810" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_discovery_telegram" value="alerts: unhealthy, critical load,&#10;breaker removal (5 min cooldown)" style="html=1;endArrow=block;strokeColor=#0f766e;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1810" y="670" as="sourcePoint" /><mxPoint x="1810" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_player" value="/call/player&#10;/auth /players /trades" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="350" as="sourcePoint" /><mxPoint x="130" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_player" value="pub player.registered&#10;pub player.leveled_up&#10;sub game.presence_changed" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="350" as="sourcePoint" /><mxPoint x="290" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_game" value="/call/game · calls World,&#10;Zombie, Exam, Player,&#10;Resource, Base" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="350" as="sourcePoint" /><mxPoint x="490" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_game" value="pub game.action_completed&#10;pub game.presence_changed&#10;sub resource.gathered&#10;sub exam.completed&#10;sub world.wing_unlocked" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="650" y="350" as="sourcePoint" /><mxPoint x="650" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_exam" value="/call/exam&#10;calls Zombie, Player" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="350" as="sourcePoint" /><mxPoint x="850" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_exam" value="pub exam.completed" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;startArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="350" as="sourcePoint" /><mxPoint x="1010" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_world" value="/call/world" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="350" as="sourcePoint" /><mxPoint x="1210" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_world" value="pub world.wing_unlocked&#10;sub exam.completed" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="350" as="sourcePoint" /><mxPoint x="1370" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_resource" value="/call/resource&#10;calls World" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="620" as="sourcePoint" /><mxPoint x="130" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_resource" value="pub resource.gathered&#10;sub player.registered&#10;sub game.action_completed" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="620" as="sourcePoint" /><mxPoint x="290" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_zombie" value="/call/zombie" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="620" as="sourcePoint" /><mxPoint x="490" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_base" value="/call/base&#10;calls Resource, World, Player" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="620" as="sourcePoint" /><mxPoint x="850" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_base" value="sub player.registered" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=none;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1010" y="620" as="sourcePoint" /><mxPoint x="1010" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_crafting" value="/call/crafting&#10;calls Resource, Player" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1210" y="620" as="sourcePoint" /><mxPoint x="1210" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_crafting" value="sub player.leveled_up&#10;sub exam.completed&#10;sub world.wing_unlocked" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=none;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1370" y="620" as="sourcePoint" /><mxPoint x="1370" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="legendData" value="Replication / ETL (data layer)" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1160" y="72" width="470" height="18" as="geometry" /></mxCell>
        <mxCell id="legendDataLine" value="" style="html=1;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1130" y="81" as="sourcePoint" /><mxPoint x="1160" y="81" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b_cache" value="Cache (Lab 5): auth data and GET answers" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="2030" y="150" width="330" height="230" as="geometry" /></mxCell>
        <mxCell id="cache_note" value="&lt;b&gt;Valkey ×3&lt;/b&gt; · in-memory, 32 MB each&lt;br&gt;sharded by its clients with &lt;b&gt;consistent hashing&lt;/b&gt;:&lt;br&gt;160 points per shard on a 2^64 ring, a key goes&lt;br&gt;to the first point clockwise from md5(key)&lt;br&gt;auth:session:&amp;lt;sha256(token)&amp;gt; → claims (≤ 300 s)&lt;br&gt;auth:revoked:&amp;lt;sha256(token)&amp;gt; → on 2 shards&lt;br&gt;zombie:… · exam:questions… · world:map… 300 s&lt;br&gt;resource:player:&amp;lt;id&amp;gt;… 30 s · exam:player:&amp;lt;id&amp;gt;… 60 s&lt;br&gt;shard down → keys go clockwise" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="2045" y="175" width="305" height="105" as="geometry" /></mxCell>
        <mxCell id="redis0" value="redis-0" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="2045" y="295" width="90" height="60" as="geometry" /></mxCell>
        <mxCell id="redis1" value="redis-1" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="2150" y="295" width="90" height="60" as="geometry" /></mxCell>
        <mxCell id="redis2" value="redis-2" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="2255" y="295" width="90" height="60" as="geometry" /></mxCell>
        <mxCell id="e_gw_cache" value="token lookups&#10;logout revocations" style="verticalAlign=bottom;labelPosition=center;html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1960" y="270" as="sourcePoint" /><mxPoint x="2030" y="270" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="b_saga" value="Saga coordinator (Lab 5, inside the gateway)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="2030" y="430" width="330" height="440" as="geometry" /></mxCell>
        <mxCell id="saga_note" value="&lt;b&gt;Long-running sagas instead of 2PC&lt;/b&gt;&lt;br&gt;POST /sagas/{name} (services only)&lt;br&gt;each step goes through the broker, each state&lt;br&gt;change is stored before the next step&lt;br&gt;refused → compensate, newest step first&lt;br&gt;no answer → retry with the same Idempotency-Key&lt;br&gt;a dead gateway&#x27;s sagas continue on another (lease)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2045" y="455" width="300" height="115" as="geometry" /></mxCell>
        <mxCell id="saga_spend" value="&lt;b&gt;spend-for-item&lt;/b&gt;&lt;br&gt;1 Resource reserve 900 s&amp;nbsp;&amp;nbsp;✗ release&lt;br&gt;2 Player add item&amp;nbsp;&amp;nbsp;(pivot)&lt;br&gt;3 Resource commit&amp;nbsp;&amp;nbsp;(retried until done)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2045" y="582" width="300" height="75" as="geometry" /></mxCell>
        <mxCell id="saga_attack" value="&lt;b&gt;tourist-attack&lt;/b&gt;&lt;br&gt;1 Zombie read&lt;br&gt;2 Resource steal&amp;nbsp;&amp;nbsp;✗ refund&lt;br&gt;3 Player take XP&amp;nbsp;&amp;nbsp;(pivot)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#c2410c;fontSize=10;align=left;verticalAlign=middle;spacingLeft=8;arcSize=10;" vertex="1" parent="1"><mxGeometry x="2045" y="669" width="300" height="75" as="geometry" /></mxCell>
        <mxCell id="gateway_db" value="gateway-db
PostgreSQL ×3 (Patroni)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="2115" y="765" width="160" height="75" as="geometry" /></mxCell>
        <mxCell id="e_saga_db" value="" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2195" y="744" as="sourcePoint" /><mxPoint x="2195" y="765" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_gw_saga" value="runs inside" style="html=1;startArrow=none;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1960" y="330" as="sourcePoint" /><mxPoint x="2030" y="510" as="targetPoint" /><Array as="points"><mxPoint x="2000" y="330" /><mxPoint x="2000" y="510" /></Array></mxGeometry></mxCell>
        <mxCell id="cache_resource" value="GET balances, ledger ⇄ Valkey" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#b45309;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="840" width="300" height="18" as="geometry" /></mxCell>
        <mxCell id="cache_zombie" value="GET definitions ⇄ Valkey" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#b45309;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="840" width="300" height="18" as="geometry" /></mxCell>
        <mxCell id="cache_exam" value="GET questions, history ⇄ Valkey · GETs → replica" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#b45309;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="330" width="300" height="18" as="geometry" /></mxCell>
        <mxCell id="cache_world" value="GET map ⇄ Valkey · GETs → replica" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#b45309;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="330" width="300" height="18" as="geometry" /></mxCell>
        <mxCell id="b_data" value="Data layer (Lab 5)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="60" y="900" width="1380" height="300" as="geometry" /></mxCell>
        <mxCell id="pg_title" value="&lt;b&gt;Every service database is a 3-node Patroni cluster&lt;/b&gt; (player-db … crafting-db, 9 × 3 nodes, gateway-db included): built-in streaming replication, one primary, two replicas · the services keep their hostname and DATABASE_URL" style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="922" width="780" height="32" as="geometry" /></mxCell>
        <mxCell id="pg_haproxy" value="&lt;b&gt;HAProxy&lt;/b&gt; · &amp;lt;service&amp;gt;-db&lt;br&gt;:5432 → the primary only&lt;br&gt;:5433 → a replica (read-only)&lt;br&gt;polls Patroni GET /primary, /replica every 2 s&lt;br&gt;cuts sessions to a demoted node" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ede9fe;strokeColor=#7c3aed;" vertex="1" parent="1"><mxGeometry x="80" y="965" width="250" height="90" as="geometry" /></mxCell>
        <mxCell id="pg_node0" value="&amp;lt;service&amp;gt;-db-0&lt;br&gt;&lt;b&gt;primary&lt;/b&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="410" y="975" width="130" height="70" as="geometry" /></mxCell>
        <mxCell id="pg_node1" value="&amp;lt;service&amp;gt;-db-1&lt;br&gt;replica" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="640" y="955" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="pg_node2" value="&amp;lt;service&amp;gt;-db-2&lt;br&gt;replica" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="640" y="1045" width="130" height="60" as="geometry" /></mxCell>
        <mxCell id="pg_etcd" value="&lt;b&gt;etcd&lt;/b&gt;&lt;br&gt;leader lock (ttl 20 s)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#0f766e;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="410" y="1100" width="130" height="70" as="geometry" /></mxCell>
        <mxCell id="pg_note" value="Primary dies → its lock expires (at once on a clean stop), the most up-to-date replica is promoted, the other one follows it. The old primary comes back → finds the lock taken, pg_rewind, rejoins as a replica." style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="80" y="1075" width="300" height="110" as="geometry" /></mxCell>
        <mxCell id="e_pg_primary" value=":5432" style="html=1;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg_haproxy" target="pg_node0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pg_wal1" value="WAL stream" style="html=1;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg_node0" target="pg_node1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pg_wal2" value="WAL stream" style="html=1;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg_node0" target="pg_node2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_pg_lock" value="holds the lock" style="html=1;endArrow=block;dashed=1;strokeColor=#0f766e;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg_node0" target="pg_etcd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="etl" value="&lt;b&gt;warehouse-etl&lt;/b&gt; · every 60 s&lt;br&gt;postgres_fdw: every database, re-imported each run&lt;br&gt;extract → staging_&amp;lt;service&amp;gt; (full snapshot)&lt;br&gt;→ transform into the dw star schema&lt;br&gt;each step commits alone, logged in etl.runs" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#fff7ed;strokeColor=#ea580c;" vertex="1" parent="1"><mxGeometry x="900" y="965" width="245" height="95" as="geometry" /></mxCell>
        <mxCell id="warehouse" value="&lt;b&gt;warehouse-db&lt;/b&gt; (PostgreSQL)&lt;br&gt;dw.dim_player · dim_item · dim_zombie · dim_location&lt;br&gt;dw.fact_craft · fact_exam · fact_resource · fact_event&lt;br&gt;views player_report · daily_activity" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=10;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="1170" y="935" width="255" height="150" as="geometry" /></mxCell>
        <mxCell id="e_etl_src" value="snapshots from&#10;the replicas (:5433)" style="html=1;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg_node1" target="etl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_etl_dw" value="load" style="html=1;endArrow=block;strokeColor=#7c3aed;strokeWidth=2;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="etl" target="warehouse"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="dw_note" value="The ETL reads only replicas, so it never loads a primary; a failing source keeps its previous snapshot and the other steps carry on." style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="880" y="1080" width="540" height="40" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
