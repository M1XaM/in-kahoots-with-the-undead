        <mxCell id="db_e_zombie0" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="zombie" target="db_zombie0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_base" value="Service Boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="780" y="620" width="300" height="240" as="geometry" /></mxCell>
