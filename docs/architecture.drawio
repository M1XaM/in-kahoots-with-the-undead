        <mxCell id="legendRest" value="REST (sync): client → Gateway → Broker → service, service → Broker → service" style="text;html=1;fontSize=11;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="1160" y="12" width="470" height="18" as="geometry" /></mxCell>
