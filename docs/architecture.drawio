        <mxCell id="db_e_base0" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="base" target="db_base0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="b_crafting" value="Service Boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1140" y="620" width="300" height="240" as="geometry" /></mxCell>
        <mxCell id="crafting" value="Crafting Service&#10;&#10;recipes, atomic crafting,&#10;unlock conditions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1160" y="660" width="260" height="100" as="geometry" /></mxCell>
        <mxCell id="db_crafting0" value="PostgreSQL" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="1245" y="780" width="90" height="60" as="geometry" /></mxCell>
        <mxCell id="db_e_crafting0" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="crafting" target="db_crafting0"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="broker" value="&lt;b&gt;Camus Message Broker&lt;/b&gt; · Dart · :8091 HTTP · :8092 gRPC · every service-to-service call and every event goes through it (X-Internal-Key) · registers with Discovery like a service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#be185d;strokeWidth=2;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1380" height="130" as="geometry" /></mxCell>
        <mxCell id="brk_queues" value="&lt;b&gt;Request queues&lt;/b&gt; (subscriber-based)&lt;br&gt;one bounded FIFO per target service&lt;br&gt;dispatch when an instance has capacity&lt;br&gt;429 queue full · 503 no instance · 504 deadline" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="80" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="brk_lb" value="&lt;b&gt;Load balancer + circuit breakers&lt;/b&gt;&lt;br&gt;round-robin → least-load&lt;br&gt;3 failures in 105 s trip an instance&lt;br&gt;reroute only idempotent calls · reports to Discovery" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="brk_topics" value="&lt;b&gt;Topics&lt;/b&gt; (topic-based)&lt;br&gt;durable queue per (topic, subscriber service)&lt;br&gt;subscribers come from Discovery &lt;i&gt;topics&lt;/i&gt;&lt;br&gt;retry 1 s → 30 s, 5 attempts, then dead letter" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="brk_dlq" value="&lt;b&gt;Dead letter channel + store&lt;/b&gt;&lt;br&gt;max_attempts · rejected · no_subscribers&lt;br&gt;GET /dead-letters · GET /topics&lt;br&gt;LogStore: append-only log, fsync before 202" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#ffffff;strokeColor=#be185d;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="458" width="320" height="82" as="geometry" /></mxCell>
        <mxCell id="client" value="Game client (browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="80" width="300" height="40" as="geometry" /></mxCell>
        <mxCell id="b_gateway" value="Service Boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="150" width="340" height="230" as="geometry" /></mxCell>
        <mxCell id="gateway" value="&lt;b&gt;API Gateway&lt;/b&gt; · Python / FastAPI · :8080&lt;br&gt;single entry point for the client&lt;br&gt;JWT authorization (Authorization header never forwarded)&lt;br&gt;task timeout + concurrent task limit&lt;br&gt;routes by path prefix to the broker: /call/{service}/…&lt;br&gt;GET /logs: merged NDJSON log download&lt;br&gt;WebSocket negotiation: GET /ws/game&lt;br&gt;no load balancing or circuit breaker any more" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f2937;strokeColor=#111827;strokeWidth=2;fontColor=#ffffff;fontSize=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="185" width="300" height="170" as="geometry" /></mxCell>
        <mxCell id="b_discovery" value="Service Boundary" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;fontSize=10;fontStyle=2;fillColor=none;strokeColor=#999999;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1640" y="430" width="340" height="240" as="geometry" /></mxCell>
        <mxCell id="discovery" value="Discovery Service · :8089&#10;&#10;instance registry, heartbeat TTL,&#10;health checks (/status), load alerts&#10;+ topics, grpc_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ccfbf1;strokeColor=#0f766e;fontSize=13;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1660" y="470" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="db_discovery" value="Registry&#10;(in-memory)" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="1765" y="590" width="90" height="60" as="geometry" /></mxCell>
        <mxCell id="db_e_discovery" style="edgeStyle=none;html=1;endArrow=none;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="discovery" target="db_discovery"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="telegram" value="Telegram bot (alert channel)&#10;optional: TELEGRAM_BOT_TOKEN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#6b7280;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1660" y="730" width="300" height="50" as="geometry" /></mxCell>
        <mxCell id="discovery_note" value="&lt;b&gt;Every service (gateway and broker included)&lt;/b&gt; → Discovery:&lt;br&gt;POST /services/register on startup (with topics, later grpc_url)&lt;br&gt;PUT …/heartbeat every 10 s (404 = register again)&lt;br&gt;DELETE …/instances/{id} on shutdown&lt;br&gt;&lt;b&gt;Discovery&lt;/b&gt; → every instance: GET /status every 5 s&lt;br&gt;3 failed checks = unhealthy · no sign of life for 30 s = dropped&lt;br&gt;load = active / max tasks: ≥ 0.7 warn, ≥ 0.9 alert&lt;br&gt;&lt;b&gt;Broker&lt;/b&gt; → Discovery: GET /services every 2 s, failure reports" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#f0fdfa;strokeColor=#0f766e;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="800" width="340" height="140" as="geometry" /></mxCell>
        <mxCell id="monitoring" value="&lt;b&gt;Monitoring&lt;/b&gt; · Prometheus :9090 · Grafana :3001&lt;br&gt;scrapes /metrics on the broker and every Base / Crafting replica&lt;br&gt;Grafana dashboard &quot;Kahoot With Undead&quot; (provisioned)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=10;fillColor=#f9fafb;strokeColor=#6b7280;dashed=1;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1640" y="955" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="e_client_gateway" value="REST · cookie or Bearer" style="html=1;endArrow=block;strokeColor=#000000;fontSize=11;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1810" y="120" as="sourcePoint" /><mxPoint x="1810" y="185" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_client_game_ws" value="Socket.IO /game (URL negotiated at the gateway, then direct)" style="html=1;endArrow=block;strokeColor=#6c8ebf;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="100" as="sourcePoint" /><mxPoint x="580" y="150" as="targetPoint" /><Array as="points"><mxPoint x="580" y="100" /></Array></mxGeometry></mxCell>
        <mxCell id="e_gw_broker" value="POST/GET /call/{service}/…&#10;X-Timeout-Ms · X-Internal-Key&#10;REST (later gRPC)" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1660" y="250" as="sourcePoint" /><mxPoint x="1440" y="470" as="targetPoint" /><Array as="points"><mxPoint x="1540" y="250" /><mxPoint x="1540" y="470" /></Array></mxGeometry></mxCell>
        <mxCell id="e_broker_discovery" value="GET /services (poll 2 s)&#10;POST …/failures&#10;register + heartbeat" style="html=1;startArrow=block;endArrow=block;strokeColor=#0f766e;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="520" as="sourcePoint" /><mxPoint x="1640" y="520" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_gw_discovery" value="register + heartbeat" style="html=1;startArrow=block;endArrow=block;strokeColor=#0f766e;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;align=left;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1810" y="380" as="sourcePoint" /><mxPoint x="1810" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="e_discovery_telegram" value="alerts: unhealthy, critical load,&#10;breaker removal (5 min cooldown)" style="html=1;endArrow=block;strokeColor=#0f766e;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1810" y="670" as="sourcePoint" /><mxPoint x="1810" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_player" value="/call/player&#10;/auth /players /trades" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="350" as="sourcePoint" /><mxPoint x="130" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="ev_player" value="pub player.registered&#10;pub player.leveled_up&#10;sub game.presence_changed" style="html=1;dashed=1;strokeColor=#6c8ebf;fontSize=9;labelBackgroundColor=#ffffff;endArrow=block;startArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="290" y="350" as="sourcePoint" /><mxPoint x="290" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="call_game" value="/call/game · calls World,&#10;Zombie, Exam, Player,&#10;Resource, Base" style="html=1;startArrow=block;endArrow=block;strokeColor=#000000;fontSize=9;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="490" y="350" as="sourcePoint" /><mxPoint x="490" y="420" as="targetPoint" /></mxGeometry></mxCell>
