%%{init: {"flowchart": {"wrappingWidth": 900, "nodeSpacing": 30, "rankSpacing": 70}, "themeVariables": {"fontSize": "15px"}}}%%
flowchart TB
    client(["<b>Game client</b> (browser)"])

    gateway["<b>API Gateway</b> · Python / FastAPI · :8080<br/>single entry point for client and service-to-service REST<br/>JWT authorization (Authorization header is never forwarded) · task timeout + concurrent task limit<br/>round-robin over the healthy instances from Service Discovery · X-Upstream-Instance<br/>circuit breaker: 3 failures in 105 s remove the instance · WebSocket negotiation: GET /ws/{service}"]

    discovery["<b>Service Discovery</b> · Python / FastAPI · :8089<br/>registry of every running instance (register · heartbeat · deregister)<br/>checks each instance's GET /status every 5 s · load alerts at 0.7 / 0.9<br/>removes instances reported by circuit breakers"]
    telegram(["<b>Telegram</b><br/>developers' chat"])

    client -- "REST · cookie or Bearer" --> gateway
    gateway -- "GET /services every 2 s<br/>failure reports" --> discovery
    discovery -- "critical alerts" --> telegram
    client -. "Socket.IO /game · URL negotiated at the gateway, then direct" .-> game

    subgraph services["Services · each owns its own PostgreSQL · service-to-service REST goes back through the gateway with X-Internal-Key"]
        direction LR
        player["<b>Player</b> · Go<br/>identity, auth, inventory,<br/>XP, trading"]
        game["<b>Game</b> · NestJS<br/>sessions, day/night,<br/>timed actions + Redis"]
        exam["<b>Exam</b> · NestJS<br/>exams, grades,<br/>achievements"]
        world["<b>World</b> · NestJS<br/>campus map, rooms,<br/>resource nodes"]
        zombie["<b>Zombie</b> · NestJS<br/>zombie types,<br/>stats, abilities"]
        resource["<b>Resource</b> · NestJS<br/>balances, ledger,<br/>reservations"]
        base["<b>Base</b> · Go · ×2–3<br/>upgrades, barricades,<br/>Kiki rewards"]
        crafting["<b>Crafting</b> · Go · ×2–3<br/>recipes, atomic<br/>crafting"]
    end

    services -- "register on startup · heartbeat · deregister on shutdown<br/>failure reports from circuit breakers" --> discovery
    discovery -. "GET /status (health + load)" .-> services

    gateway <-- "/auth /players /trades" --> player
    gateway <-- "/game<br/>calls World, Zombie, Exam,<br/>Player, Resource, Base" --> game
    gateway <-- "/exams<br/>calls Zombie, Player" --> exam
    gateway <-- "/world" --> world
    gateway <-- "/zombies" --> zombie
    gateway <-- "/resources<br/>calls World" --> resource
    gateway <-- "/base<br/>calls Resource, World, Player" --> base
    gateway <-- "/crafting<br/>calls Resource, Player" --> crafting

    exam -. "exam.completed" .-> world
    world -. "world.wing_unlocked" .-> game
    player -. "player.registered" .-> resource
    game -. "game.action_completed" .-> resource

    legend["<b>Legend</b><br/>solid: REST through the gateway (and to Service Discovery)<br/>dashed: WebSocket opened directly on the producer, or a health check<br/>(service /events streams are negotiated at the gateway too)<br/>×2–3: replicas, each registered with Service Discovery<br/>blue: Go · yellow: NestJS · dark: gateway, purple: Service Discovery (banned language)"]
    services ~~~ legend

